{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": "allow",
    "edit": "allow",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow",
    "task": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "codesearch": "allow",
    "question": "allow",
    "mymcp_*": "ask"
  },
  "model": "saia/glm-4.7",
  "provider": {
    "saia": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "SAIA (GWDG Chat AI)",
      "options": {
        "baseURL": "https://chat-ai.academiccloud.de/v1",
        "apiKey": "{env:SAIA_API_KEY}"
      },
      "models": {
        "apertus-70b-instruct-2509": {"name": "Apertus 70B — Open-source instruct model", "limit": {"context": 65536, "output": 8192}},
        "deepseek-v4-flash": {"name": "DeepSeek V4 Flash 284B MoE (1M ctx) — Strong reasoning", "can_reason": true, "limit": {"context": 1000000, "output": 32768}},
        "devstral-2-123b-instruct-2512": {"name": "Devstral 2 123B (256k ctx) — Agentic coder", "limit": {"context": 256000, "output": 16384}},
        "gemma-4-31b-it": {"name": "Gemma 4 31B (256k ctx) — Google latest", "limit": {"context": 256000, "output": 8192}},
        "glm-4.7": {"name": "GLM-4.7 (128k ctx) — Agentic coding, strong tool use", "can_reason": true, "limit": {"context": 128000, "output": 16384}},
        "medgemma-27b-it": {"name": "MedGemma 27B — Medical domain specialist", "limit": {"context": 32768, "output": 4096}},
        "meta-llama-3.1-8b-instruct": {"name": "Llama 3.1 8B — Meta fast lightweight", "limit": {"context": 128000, "output": 4096}},
        "mistral-medium-3.5-128b": {"name": "Mistral Medium 3.5 128B (256k ctx) — Great overall", "can_reason": true, "limit": {"context": 256000, "output": 32768}},
        "openai-gpt-oss-120b": {"name": "OpenAI GPT-OSS 120B — Large context model", "limit": {"context": 128000, "output": 8192}},
        "qwen3-30b-a3b-instruct-2507": {"name": "Qwen3 30B Instruct — General purpose", "can_reason": true, "limit": {"context": 131072, "output": 16384}},
        "qwen3-coder-next": {"name": "Qwen3 Coder Next 80B MoE (256k ctx) — Code-specialized", "limit": {"context": 256000, "output": 16384}},
        "qwen3-omni-30b-a3b-instruct": {"name": "Qwen3 Omni 30B — Multimodal (text+audio)", "attachment": true, "limit": {"context": 32768, "output": 4096}},
        "qwen3.5-122b-a10b": {"name": "Qwen3.5 122B MoE (128k ctx) — Strong reasoning, fast", "can_reason": true, "limit": {"context": 128000, "output": 32768}},
        "qwen3.5-397b-a17b": {"name": "Qwen3.5 397B MoE (128k ctx) — Flagship reasoning, best quality", "can_reason": true, "limit": {"context": 128000, "output": 32768}},
        "qwen3.6-27b": {"name": "Qwen3.6 27B Dense (262k ctx) — Vision, reasoning", "can_reason": true, "attachment": true, "limit": {"context": 262000, "output": 32768}},
        "qwen3.6-35b-a3b": {"name": "Qwen3.6 35B MoE (262k ctx) — Vision, reasoning, agentic coding", "can_reason": true, "attachment": true, "limit": {"context": 262000, "output": 32768}}
      }
    }
  }
}
