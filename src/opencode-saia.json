        "mistral-large-3-675b-instruct-2512": {"name": "Mistral Large 3 675B (128k ctx) — Largest model, strong generalist", "options": {"enable-tools": true, "enable-auto-tool-choice": true, "tool-call-parser": "openai"}, "limit": {"context": 128000, "output": 32768}},
        "openai-gpt-oss-120b": {"name": "OpenAI GPT-OSS 120B — Large context model", "options": {"enable-tools": true, "enable-auto-tool-choice": true, "tool-call-parser": "openai"}, "limit": {"context": 128000, "output": 8192}},
        "qwen3-235b-a22b": {"name": "Qwen3 235B MoE (128k ctx) — Large context, strong generalist", "options": {"enable-tools": true, "enable-auto-tool-choice": true, "tool-call-parser": "openai"}, "can_reason": true, "limit": {"context": 128000, "output": 32768}},
        "qwen3-30b-a3b-instruct-2507": {"name": "Qwen3 30B Instruct — General purpose", "options": {"enable-tools": true, "enable-auto-tool-choice": true, "tool-call-parser": "openai"}, "can_reason": true, "limit": {"context": 131072, "output": 16384}},
