        "qwen3.5-122b-a10b": {"name": "Qwen3.5 122B MoE (128k ctx) — Strong reasoning, fast", "options": {"enable-tools": true, "enable-auto-tool-choice": true, "tool-call-parser": "openai"}, "can_reason": true, "limit": {"context": 128000, "output": 32768}},
        "qwen3.5-27b": {"name": "Qwen3.5 27B Dense (128k ctx) — Efficient reasoning", "options": {"enable-tools": true, "enable-auto-tool-choice": true, "tool-call-parser": "openai"}, "can_reason": true, "limit": {"context": 128000, "output": 16384}},
        "qwen3.5-35b-a3b": {"name": "Qwen3.5 35B MoE (128k ctx) — Fast reasoning", "options": {"enable-tools": true, "enable-auto-tool-choice": true, "tool-call-parser": "openai"}, "can_reason": true, "limit": {"context": 128000, "output": 16384}},
        "qwen3.5-397b-a17b": {"name": "Qwen3.5 397B MoE (128k ctx) — Flagship reasoning, best quality", "options": {"enable-tools": true, "enable-auto-tool-choice": true, "tool-call-parser": "openai"}, "can_reason": true, "limit": {"context": 128000, "output": 32768}},
