{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": "allow",
    "edit": "allow",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow",
    "task": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "codesearch": "allow",
    "question": "allow",
    "mymcp_*": "ask"
  },
  "formatter": {},
  "model": "saia/glm-4.7",
  "fallback_model": "saia/llama-3.1-8b-instruct",
  "provider": {
    "saia": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "SAIA (GWDG Chat AI)",
      "options": {
        "baseURL": "https://chat-ai.academiccloud.de/v1",
        "apiKey": "{env:SAIA_API_KEY}"
      },
      "models": {
        "apertus-70b-instruct-2509": {"name": "Apertus 70B — Open-source instruct model", "options": {"enable-tools": true, "enable-auto-tool-choice": true, "tool-call-parser": "openai"}, "limit": {"context": 128000, "output": 8192}},
        "deepseek-r1-distill-llama-70b": {"name": "DeepSeek R1 Distill 70B — Reasoning (Llama base)", "options": {"enable-tools": true, "enable-auto-tool-choice": true, "tool-call-parser": "openai"}, "can_reason": true, "limit": {"context": 128000, "output": 16384}},
        "devstral-2-123b-instruct-2512": {"name": "Devstral 2 123B — Mistral's agentic coder", "options": {"enable-tools": true, "enable-auto-tool-choice": true, "tool-call-parser": "openai"}, "limit": {"context": 128000, "output": 16384}},
        "gemma-3-27b-it": {"name": "Gemma 3 27B — Google lightweight model", "options": {"enable-tools": true, "enable-auto-tool-choice": true, "tool-call-parser": "openai"}, "limit": {"context": 131072, "output": 8192}},
        "gemma-4-31b-it": {"name": "Gemma 4 31B — Google latest", "options": {"enable-tools": true, "enable-auto-tool-choice": true, "tool-call-parser": "openai"}, "limit": {"context": 131072, "output": 8192}},
        "glm-4.7": {"name": "GLM-4.7 (128k ctx) — Agentic coding, strong tool use", "options": {"enable-tools": true, "enable-auto-tool-choice": true, "tool-call-parser": "openai"}, "can_reason": true, "limit": {"context": 128000, "output": 16384}},
        "internvl3.5-30b-a3b": {"name": "InternVL 3.5 30B — Vision-language", "options": {"enable-tools": true, "enable-auto-tool-choice": true, "tool-call-parser": "openai"}, "attachment": true, "limit": {"context": 32768, "output": 4096}},
        "llama-3.1-8b-instruct": {"name": "Llama 3.1 8B — Meta lightweight", "options": {"enable-tools": true, "enable-auto-tool-choice": true, "tool-call-parser": "openai"}, "limit": {"context": 128000, "output": 4096}},
        "llama-3.1-sauerkrautlm-70b-instruct": {"name": "SauerkrautLM 70B — German-enhanced Llama", "options": {"enable-tools": true, "enable-auto-tool-choice": true, "tool-call-parser": "openai"}, "limit": {"context": 128000, "output": 4096}},
        "llama-3.3-70b-instruct": {"name": "Llama 3.3 70B — Meta strong generalist", "options": {"enable-tools": true, "enable-auto-tool-choice": true, "tool-call-parser": "openai"}, "limit": {"context": 128000, "output": 8192}},
