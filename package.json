{
  "name": "opencode-saia-plugin",
  "version": "0.4.1",
  "description": "Runtime SAIA (GWDG Chat AI) plugin for OpenCode",
  "type": "module",
  "main": "./src/saia.ts",
  "bin": {
    "generate-saia-config": "./src/generate-saia-config.sh",
    "copy-saia-config": "./src/copy-saia-config.sh",
    "validate-saia-config": "./src/validate-config.sh",
    "setup-saia-wizard": "./src/setup-wizard.sh"
  },
  "files": [
    "src/",
    "schema/",
    "scripts/",
    "data/",
    ".opencode/",
    "install.sh",
    "install.ps1",
    "LICENSE",
    "README.md",
    "FAQ.md"
  ],
  "scripts": {
    "prepare-release": "bash prepare-release.sh",
    "test": "node --import tsx --test src/*.test.mjs",
    "validate": "bash src/validate-config.sh opencode.json",
    "generate": "bash src/generate-saia-config.sh",
    "sync-models": "./scripts/sync-saia-models.sh",
    "tsc": "tsc --noEmit --skipLibCheck"
  },
  "repository": {
    "type": "git",
    "url": "https://codeberg.org/graphwiz-ai/opencode-saia-plugin.git"
  },
  "keywords": [
    "opencode",
    "saia",
    "gwdg",
    "ai",
    "plugin",
    "models",
    "chat-ai"
  ],
  "license": "MIT",
  "author": "graphwiz-ai",
  "bugs": {
    "url": "https://codeberg.org/graphwiz-ai/opencode-saia-plugin/issues"
  },
  "homepage": "https://codeberg.org/graphwiz-ai/opencode-saia-plugin",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.33",
    "@opencode/plugin": "2.0.20",
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.5",
    "@types/node": "^20.0.0",
    "tsx": "4.23.12",
    "typescript": "5.8.2"
  },
  "packageManager": "bun@1.3.11"
}
