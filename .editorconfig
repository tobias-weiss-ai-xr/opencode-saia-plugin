root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{sh,bash}]
indent_style = space
indent_size = 2
max_line_length = 120

[*.{ts,js,json}]
indent_style = space
indent_size = 2
max_line_length = 120

[*.{md,yml,yaml}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.ps1]
indent_style = space
indent_size = 2
charset = utf-8

[.gitignore]
indent_style = unset

[{Makefile,*.mk}]
indent_style = tab
